#!/usr/bin/env bash
# Fake Orca CLI for deliver.py tests. Behaviour is chosen by FAKE_ORCA_SCENARIO:
#   link      share/update succeed, tabs work
#   disabled  share refused with artifact_sharing_disabled, tabs work
#   auth      artifacts list refused with authentication_required, tabs work
#   notab     link refused and tab create fails too (path only)
#   shim      every call fails like the broken --no-sandbox shim
# Every invocation is appended to $FAKE_ORCA_LOG so tests can assert the calls.
set -u
printf '%s\n' "$*" >> "${FAKE_ORCA_LOG:-/dev/null}"
S="${FAKE_ORCA_SCENARIO:-link}"
if [ "$S" = shim ]; then echo "/tmp/.mount_orca/orca-ide: bad option: --no-sandbox" >&2; exit 1; fi
# Drop the --json flag before matching so `status --json` reads as `status`.
args=(); for a in "$@"; do [ "$a" = --json ] || args+=("$a"); done
cmd="${args[0]:-}"; sub="${args[1]:-}"
case "$cmd $sub" in
  "status ") echo '{"ok":true,"result":{"runtime":{"reachable":true}}}' ;;
  "artifacts list")
    if [ "$S" = auth ]; then echo '{"ok":false,"error":{"code":"authentication_required"}}'; else echo '{"ok":true,"result":{"artifacts":[]}}'; fi ;;
  "artifacts share"|"artifacts update")
    case "$S" in
      disabled|notab) echo '{"ok":false,"error":{"code":"artifact_sharing_disabled"}}' ;;
      auth) echo '{"ok":false,"error":{"code":"authentication_required"}}' ;;
      *) if [ "$sub" = update ] && [ -n "${FAKE_ORCA_UPDATE_FAIL:-}" ]; then echo "{\"ok\":false,\"error\":{\"code\":\"$FAKE_ORCA_UPDATE_FAIL\",\"message\":\"runtime blip\"}}"; elif [ "$sub" = update ] && [ "${FAKE_ORCA_NO_RECORD:-}" = 1 ]; then echo '{"ok":false,"error":{"code":"artifact_not_found"}}'; else echo "{\"ok\":true,\"result\":{\"shareUrl\":\"https://share.example/a/$sub-1\"}}"; fi ;;
    esac ;;
  "tab list")
    if [ -n "${FAKE_ORCA_EXISTING_TAB:-}" ]; then echo "{\"ok\":true,\"result\":{\"tabs\":[{\"url\":\"$FAKE_ORCA_EXISTING_TAB\",\"browserPageId\":\"page-existing\"}]}}"; else echo '{"ok":true,"result":{"tabs":[]}}'; fi ;;
  "tab create")
    if [ "$S" = notab ]; then echo '{"ok":false,"error":{"code":"selector_not_found"}}'; else echo '{"ok":true,"result":{"browserPageId":"page-new"}}'; fi ;;
  "reload --page")
    if [ "${FAKE_ORCA_TAB_GONE:-}" = 1 ]; then echo '{"ok":false,"error":{"code":"browser_tab_not_found"}}'; else echo '{"ok":true,"result":{}}'; fi ;;
  *) echo '{"ok":false,"error":{"code":"unknown_command"}}' ;;
esac
